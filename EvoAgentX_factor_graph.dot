/*
 * EvoAgentX 因子图结构（与 X:/codes/EvoAgentX/flagent/Graph/evidence.py
 * build_multi_sample_factor_graph 一一对齐）
 *
 * 渲染方法（任选其一）：
 *   方法 1：把本文件全部内容复制到 https://dreampuf.github.io/GraphvizOnline 直接出图
 *   方法 2：把本文件全部内容复制到 https://edotor.net 直接出图
 *   方法 3：本机若装了 graphviz，命令行执行：
 *           dot -Tpng EvoAgentX_factor_graph.dot -o EvoAgentX_factor_graph.png
 *           dot -Tsvg EvoAgentX_factor_graph.dot -o EvoAgentX_factor_graph.svg
 *
 * 视图覆盖：
 *   - 一个工作流节点 N（含全部 8 个子健康变量 + 3 个父健康变量 + 步骤因子链）
 *   - 边 N→M 的健康（折叠为单变量）
 *   - 一条样本 q1 的完整数据流（起点 → 提示词数据 → 输出数据 → 流向下一节点 M）
 *   - 终端节点的 EM / F1 硬观测
 *   - 抽样展示三类软观测的注入路径（提示词 / 参数 / 返回 / 边）
 */

digraph EvoAgentX_FactorGraph {
    rankdir = TB;
    compound = true;
    splines = true;
    nodesep = 0.32;
    ranksep = 0.55;

    /* Windows 中文字体；Linux/Mac 改 "Noto Sans CJK SC" 或 "PingFang SC" */
    fontname = "Microsoft YaHei";
    node [fontname = "Microsoft YaHei", fontsize = 11];
    edge [fontname = "Microsoft YaHei", fontsize = 10];

    /* ============================================================
       图例
       ============================================================ */
    subgraph cluster_legend {
        label = "图例：节点类型";
        style = "rounded,filled";
        fillcolor = "#fafafa";
        color = "#bbbbbb";
        fontcolor = "#666666";

        L1 [label = "父健康变量（隐变量，根因诊断输出对象）",
            shape = ellipse, style = filled, fillcolor = "#d6eaf8",
            color = "#2874a6", penwidth = 2];
        L2 [label = "子健康变量（隐变量，更细的责任划分）",
            shape = ellipse, style = filled, fillcolor = "#ebf5fb"];
        L3 [label = "数据变量（隐变量，每条样本独立一份）",
            shape = ellipse, style = filled, fillcolor = "#d5f5e3"];
        L4 [label = "观测节点（is_observed=True，灌入证据）",
            shape = ellipse, style = "filled,bold", fillcolor = "#fef9e7",
            color = "#b9770e", penwidth = 2];
        L5 [label = "因子节点（CPT 张量，传消息用）",
            shape = box, style = filled, fillcolor = "white"];

        L1 -> L2 [style = invis];
        L2 -> L3 [style = invis];
        L3 -> L4 [style = invis];
        L4 -> L5 [style = invis];
    }

    /* ============================================================
       上层：全局健康骨架（跨样本共享）
       ============================================================ */
    subgraph cluster_global {
        label = "上层 —— 全局健康骨架（所有样本共享同一套；BP 跑完后从这层节点读根因排名）";
        style = "rounded,dashed";
        color = "#2874a6";
        fontcolor = "#2874a6";

        /* 节点 N 的 8 个子健康变量（is_health_node=True） */
        node [shape = ellipse, style = filled, fillcolor = "#ebf5fb", color = "#5499c7"];
        ch_pb [label = "提示词·输入绑定\n(子健康)"];
        ch_pc [label = "提示词·输出契约\n(子健康)"];
        ch_pg [label = "提示词·上下文接地\n(子健康)"];
        ch_pl [label = "参数·长度完整\n(子健康)"];
        ch_pp [label = "参数·可解析\n(子健康)"];
        ch_rt [label = "返回·类型正确\n(子健康)"];
        ch_re [label = "返回·证据充分\n(子健康)"];
        ch_rk [label = "返回·任务正确\n(子健康)"];

        /* 节点 N 的 3 个父健康变量 */
        node [shape = ellipse, style = filled, fillcolor = "#d6eaf8",
              color = "#2874a6", penwidth = 2];
        H_Prompt [label = "节点 N · 提示词总健康\n(父，先验 P=0.85)"];
        H_Params [label = "节点 N · 参数总健康\n(父，先验 P=0.85)"];
        H_Return [label = "节点 N · 返回总健康\n(父，先验 P=0.85)"];

        /* 边健康（已折叠为单一变量，无子） */
        H_Edge [label = "边 N→M · 健康\n(已折叠为单变量，无子健康)",
                fillcolor = "#fadbd8", color = "#c0392b"];

        /* 3 个聚合因子 */
        node [shape = box, style = filled, fillcolor = "white",
              color = "black", penwidth = 1];
        F_AggPrompt [label = "聚合因子\n子→父\n(noisy-AND)"];
        F_AggParams [label = "聚合因子\n子→父\n(noisy-AND)"];
        F_AggReturn [label = "聚合因子\n子→父\n(noisy-AND)"];

        /* 子→聚合→父 */
        ch_pb -> F_AggPrompt;
        ch_pc -> F_AggPrompt;
        ch_pg -> F_AggPrompt;
        F_AggPrompt -> H_Prompt;

        ch_pl -> F_AggParams;
        ch_pp -> F_AggParams;
        F_AggParams -> H_Params;

        ch_rt -> F_AggReturn;
        ch_re -> F_AggReturn;
        ch_rk -> F_AggReturn;
        F_AggReturn -> H_Return;
    }

    /* ============================================================
       中层：样本 q1 的数据流（每条样本独立一份）
       ============================================================ */
    subgraph cluster_sample {
        label = "中层 —— 样本 q1 的数据流（每条训练例都会被复制一份，名字带 __q1 后缀）";
        style = "rounded,dashed";
        color = "#196f3d";
        fontcolor = "#196f3d";

        /* 起点观测（源节点上游虚拟正确数据） */
        node [shape = ellipse, style = "filled,bold", fillcolor = "#fef9e7",
              color = "#b9770e", penwidth = 2];
        D_Start [label = "起点常量 = 1\n(观测节点，硬钉为正确)"];

        /* 节点 N 的 3 个数据变量 + 1 个边数据 */
        node [shape = ellipse, style = filled, fillcolor = "#d5f5e3",
              color = "#196f3d", penwidth = 1];
        D_Prompt [label = "节点 N · 提示词数据\n(隐，本样本独有)"];
        D_Params [label = "节点 N · 参数数据\n(隐，本样本独有)"];
        D_Out    [label = "节点 N · 输出数据\n(隐，本样本独有)"];
        D_Edge   [label = "边 N→M · 数据\n(隐，本样本独有)"];

        /* 下一节点 M 的提示词数据，仅画到这层来演示边的接续 */
        D_Prompt_M [label = "节点 M · 提示词数据\n(隐，下游)",
                    fillcolor = "#eafaf1"];

        /* 5 个步骤因子 */
        node [shape = box, style = filled, fillcolor = "white",
              color = "black", penwidth = 1];
        F_PromptStep [label = "提示词步骤因子\n(上游数据 + 父健康 → 提示词数据)\nMultiInputStepFactor"];
        F_ParamsStep [label = "参数步骤因子\n(纯门控：父健康 → 参数数据)\nHealthGatedStepFactor"];
        F_ReturnStep [label = "返回步骤因子\n(提示词数据 + 参数数据 + 父健康 → 输出数据)\nMultiInputStepFactor"];
        F_EdgeStep   [label = "边步骤因子\n(上游输出 + 边健康 → 边数据)\nMultiInputStepFactor"];
        F_PromptStep_M [label = "节点 M\n提示词步骤因子"];

        /* 数据流主干 */
        D_Start    -> F_PromptStep;
        F_PromptStep -> D_Prompt;
        F_ParamsStep -> D_Params;
        D_Prompt   -> F_ReturnStep;
        D_Params   -> F_ReturnStep;
        F_ReturnStep -> D_Out;
        D_Out      -> F_EdgeStep;
        F_EdgeStep -> D_Edge;
        D_Edge     -> F_PromptStep_M;
        F_PromptStep_M -> D_Prompt_M;
    }

    /* ============================================================
       下层：观测层（每条样本独立一份）
       ============================================================ */
    subgraph cluster_obs {
        label = "下层 —— 观测层（每条样本独立一份，is_observed=True 的节点把外部信号灌入图）";
        style = "rounded,dashed";
        color = "#b9770e";
        fontcolor = "#b9770e";

        /* 观测节点（黄色双边） */
        node [shape = ellipse, style = "filled,bold", fillcolor = "#fef9e7",
              color = "#b9770e", penwidth = 2];
        Obs_PG [label = "观测·提示词接地分数\n(启发式打分，软证据)"];
        Obs_PP [label = "观测·参数可解析\n(可直接测，确定证据)"];
        Obs_RK [label = "观测·返回任务正确分\n(LLM judge 或终端 metric)"];
        Obs_EC [label = "观测·边消费完整\n(启发式打分，软证据)"];
        Obs_EM [label = "观测·终端 EM 分数\n(=金标签匹配，真硬证据)"];
        Obs_F1 [label = "观测·终端 F1 分数\n(=金标签匹配，真硬证据)"];

        /* 观测因子 */
        node [shape = box, style = filled, fillcolor = "white",
              color = "black", penwidth = 1];
        F_ObsPG [label = "观测因子\n(子健康 + 数据 → 观测)\nObservationFactor"];
        F_ObsPP [label = "观测因子\nObservationFactor"];
        F_ObsRK [label = "观测因子\nObservationFactor"];
        F_ObsEC [label = "边观测因子\nObservationFactor"];
        F_ObsEM [label = "数据观测因子\n(只接数据，不绕健康)\nDataObservationFactor"];
        F_ObsF1 [label = "数据观测因子\nDataObservationFactor"];

        /* 观测因子 → 观测节点 */
        F_ObsPG -> Obs_PG;
        F_ObsPP -> Obs_PP;
        F_ObsRK -> Obs_RK;
        F_ObsEC -> Obs_EC;
        F_ObsEM -> Obs_EM;
        F_ObsF1 -> Obs_F1;
    }

    /* ============================================================
       跨层连线
       ============================================================ */

    /* 父健康 → 步骤因子（蓝色虚线 = 健康责任流向数据流） */
    edge [color = "#2874a6", style = dashed, fontcolor = "#2874a6"];
    H_Prompt -> F_PromptStep [label = "父健康作为门控"];
    H_Params -> F_ParamsStep;
    H_Return -> F_ReturnStep;
    H_Edge   -> F_EdgeStep;

    /* 子健康 → 观测因子 */
    ch_pg -> F_ObsPG [label = "子健康 → 观测因子"];
    ch_pp -> F_ObsPP;
    ch_rk -> F_ObsRK;
    H_Edge -> F_ObsEC [label = "边健康(无子)直接接"];

    /* 数据变量 → 观测因子 */
    edge [color = "#196f3d", style = solid, fontcolor = "#196f3d"];
    D_Prompt -> F_ObsPG [label = "数据 → 观测因子"];
    D_Params -> F_ObsPP;
    D_Out    -> F_ObsRK;
    D_Edge   -> F_ObsEC;

    /* 终端硬观测：DataObservationFactor 只连数据 */
    edge [color = "#b9770e", style = solid, fontcolor = "#b9770e"];
    D_Out -> F_ObsEM [label = "终端节点的输出数据\n直接挂金标签观测"];
    D_Out -> F_ObsF1;
}
